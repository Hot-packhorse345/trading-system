# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# ── MT5 (Windows only) ────────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Live
MT5_DLL_PATH=C:\\Program Files\\MetaTrader 5\\MQL5\\Libraries\\mt5_bridge.dll

# ── Telegram notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=bot:your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug | trace
RUST_LOG=info
# Set to 1 to output structured JSON logs (useful for log aggregators)
JSON_LOG=0
